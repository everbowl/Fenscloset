# Fen's Closet — every variable the app reads. Copy to .env for local work. In production each one lives in
# Railway → Variables, never in the code or the chat. The values here are placeholders, not real keys.

# --- Required ---
DATABASE_URL=postgresql://postgres@localhost:5433/fenscloset
SESSION_SECRET=change-me-to-32-random-characters
APP_URL=http://localhost:3000
DEV_MODE=true                         # jeff@everbowl.com / 0535 once, then a forced change; off before anyone else gets in
NODE_ENV=development

# --- Photos: Railway Storage Bucket (S3) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=                        # optional: true for path-style buckets
S3_DIRECT_UPLOADS=                    # optional: true sends photos browser → bucket with presigned links

# --- AI: tagging, outfits, shopping, store pages (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT_MS=                 # optional: one call's timeout, default 60000

# --- Background removal (remove.bg) ---
REMOVE_BG_API_KEY=

# --- Store search (Serper) ---
SERPER_API_KEY=

# --- The mirror (try-on). One engine is enough; Admin → Rules → Mirror engine picks Google, FASHN, Kling or Compare ---
# Google Vertex: a service account (the JSON on one line) and its project
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=               # optional, default us-central1
GOOGLE_VERTEX_TRYON_MODEL=            # optional
GOOGLE_VERTEX_TRYON_PERSON=           # optional
GOOGLE_VERTEX_TRYON_SAFETY=           # optional
GOOGLE_VERTEX_TRYON_STEPS=            # optional
GOOGLE_VERTEX_IMAGE_MODEL=            # optional: the image model that styles the picture (default gemini-2.5-flash-image)
GOOGLE_VERTEX_IMAGE_LOCATION=         # optional, default global
GOOGLE_VERTEX_IMAGE_SAFETY=           # optional
GOOGLE_VERTEX_SMOOTH_MODEL=           # older name for GOOGLE_VERTEX_IMAGE_MODEL, still read
GOOGLE_VERTEX_SMOOTH_LOCATION=        # older name for GOOGLE_VERTEX_IMAGE_LOCATION, still read
GOOGLE_IMAGE_HOLD_MS=                 # optional: how long the image model is left alone after a quota refusal
# FASHN
FASHN_API_KEY=
FASHN_MODE=                           # optional: performance | balanced | quality (default quality)
FASHN_MODEL=                          # optional
FASHN_MODERATION=                     # optional
FASHN_SEGMENTATION_FREE=              # optional
FASHN_POLL_MS=                        # optional
FASHN_TIMEOUT_MS=                     # optional
# Kling (Virtual Try-on 3.0): the one API key its console issues, or the older access-key / secret-key pair. Kling reads the two
# pictures by link, so the photo bucket (S3_*) has to be set as well.
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=                       # optional, default https://api-singapore.klingai.com
KLING_POLL_MS=                        # optional
KLING_TIMEOUT_MS=                     # optional

# --- Email (forgot password, invites): Resend ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Text invites: Twilio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Calendar (plans) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Work that starts on boot (optional) ---
UNTIDY_ON_START=                      # false skips the re-cut sweep when the app starts
WANTS_ON_START=                       # false skips the Looking-for search when the app starts
REQUEUE_ON_START=                     # false skips re-queuing adds that were mid-way when the app last stopped

# --- Tests and local mocks only, never in Railway (see tests/ and e2e/) ---
# MOCK_S3=true MOCK_S3_DIR=/tmp/fc-s3 MOCK_AI=true MOCK_FETCH=true MOCK_SERPER=true MOCK_WEATHER=true
# MOCK_TRYON=true MOCK_GOOGLE=true MOCK_GOOGLE_IMAGE=true MOCK_FASHN=true MOCK_KLING=true
# MOCK_FETCH_BLOCKED=true MOCK_REMOVE_BG_FAIL=true MOCK_PIECE_COUNT=3 MOCK_PIECE_COLORS=... MOCK_ORIENTATION=...
# MOCK_GARMENT_WHOLE=... MOCK_RENDER_OK=... MOCK_FEATURES=... MOCK_LABEL_BRAND=... MOCK_LABEL_SIZE=... MOCK_BACKOFF_MS=0
# MOCK_SHOP_SLOW_MS=0 SEED_FORCE=true PW_CHROMIUM=/path/to/chromium
