generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- People & access ----------

enum Role {
  admin
  member
  minor
}

enum PersonStatus {
  active
  invited
  removed
}

model Person {
  id                 String       @id @default(cuid())
  name               String
  email              String?      @unique
  phone              String?
  role               Role         @default(member)
  birthdate          DateTime?
  avatarKey          String?
  savedZip           String?
  passwordHash       String?
  mustChangePassword Boolean      @default(false)
  devPasswordActive  Boolean      @default(false)
  devPasswordUsedAt  DateTime?
  status             PersonStatus @default(invited)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions           Session[]
  resetTokens        PasswordResetToken[]
  invitesCreated     InviteToken[]
  guardians          GuardianLink[]           @relation("minorGuardians")
  wards              GuardianLink[]           @relation("parentWards")
  closets            Closet[]
  items              Item[]
  sharedItems        ItemShare[]
  importBatches      ImportBatch[]
  bodyProfile        BodyProfile?
  measurements       BodyMeasurement[]
  sizesByBrand       BodySizeByBrand[]
  bodyPhotos         BodyPhoto[]
  lovedColors        Color[]                  @relation("lovedColors")
  avoidColors        Color[]                  @relation("avoidColors")
  styleWords         StyleWord[]
  favoriteBrands     Brand[]                  @relation("favoriteBrands")
  favoriteStores     Store[]                  @relation("favoriteStores")
  bodyGrantsGiven    BodyDataGrant[]          @relation("bodyGrantOwner")
  bodyGrantsReceived BodyDataGrant[]          @relation("bodyGrantViewer")
  shopGrantsGiven    ShopForGrant[]           @relation("shopGrantOwner")
  shopGrantsReceived ShopForGrant[]           @relation("shopGrantShopper")
  bodyImageApproval  MinorBodyImageApproval?  @relation("approvalMinor")
  approvalsGiven     MinorBodyImageApproval[] @relation("approvalParent")
}

model Session {
  id              String   @id @default(cuid())
  personId        String
  tokenHash       String   @unique
  expiresAt       DateTime
  userAgent       String?
  usedDevPassword Boolean  @default(false)
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  personId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model InviteToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  name             String
  email            String?
  phone            String?
  role             Role      @default(member)
  guardianIds      String[]  @default([])
  createdById      String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedPersonId String?
  createdAt        DateTime  @default(now())

  createdBy Person @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model GuardianLink {
  minorId  String
  parentId String

  minor  Person @relation("minorGuardians", fields: [minorId], references: [id], onDelete: Cascade)
  parent Person @relation("parentWards", fields: [parentId], references: [id], onDelete: Cascade)

  @@id([minorId, parentId])
}

// ---------- Editable lists ----------

model Category {
  id            String        @id @default(cuid())
  name          String
  sortOrder     Int           @default(0)
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  subcategories Subcategory[]
  items         Item[]

  @@unique([name])
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items      Item[]

  @@unique([categoryId, name])
}

model Color {
  id         String   @id @default(cuid())
  name       String   @unique
  hex        String
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
  lovedBy    Person[] @relation("lovedColors")
  avoidedBy  Person[] @relation("avoidColors")
}

model Pattern {
  id         String   @id @default(cuid())
  name       String   @unique
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
}

model Fabric {
  id         String   @id @default(cuid())
  name       String   @unique
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
}

model Season {
  id         String   @id @default(cuid())
  name       String   @unique
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
}

model FormalityLevel {
  id         String   @id @default(cuid())
  name       String   @unique
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
}

model Occasion {
  id         String   @id @default(cuid())
  name       String   @unique
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
}

model Tag {
  id         String   @id @default(cuid())
  name       String   @unique
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
}

model Brand {
  id         String            @id @default(cuid())
  name       String            @unique
  sortOrder  Int               @default(0)
  isArchived Boolean           @default(false)
  createdAt  DateTime          @default(now())
  items      Item[]
  favoredBy  Person[]          @relation("favoriteBrands")
  sizes      BodySizeByBrand[]
}

model Store {
  id         String   @id @default(cuid())
  name       String   @unique
  url        String?
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  items      Item[]
  favoredBy  Person[] @relation("favoriteStores")
}

enum ClosetKind {
  personal
  family
  custom
}

model Closet {
  id         String       @id @default(cuid())
  name       String
  kind       ClosetKind   @default(custom)
  ownerId    String?
  sortOrder  Int          @default(0)
  isArchived Boolean      @default(false)
  createdAt  DateTime     @default(now())
  owner      Person?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items      ItemCloset[]

  @@index([ownerId])
}

model CheckInScale {
  id         String          @id @default(cuid())
  name       String          @unique
  sortOrder  Int             @default(0)
  isArchived Boolean         @default(false)
  createdAt  DateTime        @default(now())
  options    CheckInOption[]
}

model CheckInOption {
  id         String       @id @default(cuid())
  name       String
  scaleId    String
  sortOrder  Int          @default(0)
  isArchived Boolean      @default(false)
  createdAt  DateTime     @default(now())
  scale      CheckInScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, name])
}

model Rule {
  key         String   @id
  value       String
  label       String
  description String
  updatedAt   DateTime @updatedAt
}

// ---------- Items ----------

enum LaundryStatus {
  clean
  dirty
  cleaners
}

model Item {
  id            String        @id @default(cuid())
  ownerId       String
  categoryId    String?
  subcategoryId String?
  brandId       String?
  storeId       String?
  name          String?
  size          String?
  fitNotes      String?
  purchasePrice Decimal?      @db.Decimal(10, 2)
  purchaseDate  DateTime?
  purchaseUrl   String?
  isFavorite    Boolean       @default(false)
  laundryStatus LaundryStatus @default(clean)
  neverSuggest  Boolean       @default(false)
  wearCount     Int           @default(0)
  lastWornAt    DateTime?
  phash         String?
  aiConfidence  Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner         Person           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?     @relation(fields: [subcategoryId], references: [id])
  brand         Brand?           @relation(fields: [brandId], references: [id])
  store         Store?           @relation(fields: [storeId], references: [id])
  colors        Color[]
  patterns      Pattern[]
  fabrics       Fabric[]
  seasons       Season[]
  formalities   FormalityLevel[]
  occasions     Occasion[]
  tags          Tag[]
  photos        ItemPhoto[]
  closets       ItemCloset[]
  shares        ItemShare[]
  importEntries ImportEntry[]

  @@index([ownerId])
  @@index([ownerId, phash])
}

model ItemCloset {
  itemId   String
  closetId String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  closet   Closet @relation(fields: [closetId], references: [id], onDelete: Cascade)

  @@id([itemId, closetId])
}

enum PhotoKind {
  alone
  worn
  label
  cutout
  thumb
}

model ItemPhoto {
  id        String    @id @default(cuid())
  itemId    String
  kind      PhotoKind
  bucketKey String    @unique
  width     Int?
  height    Int?
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

/**
 * Item shared with a specific person outside the Family closet.
 */
model ItemShare {
  itemId   String
  personId String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([itemId, personId])
}

// ---------- Import batches (add-clothes queue) ----------

enum BatchStatus {
  open
  done
}

enum EntryStatus {
  queued
  uploaded
  processing
  needs_confirm
  done
  failed
  skipped
}

model ImportBatch {
  id        String        @id @default(cuid())
  personId  String
  status    BatchStatus   @default(open)
  total     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  person    Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  entries   ImportEntry[]

  @@index([personId, status])
}

model ImportEntry {
  id          String      @id @default(cuid())
  batchId     String
  order       Int
  originalKey String
  status      EntryStatus @default(queued)
  cutoutKey   String?
  thumbKey    String?
  labelKey    String?
  wornKey     String?
  phash       String?
  aiResult    Json?
  error       String?
  itemId      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  item        Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([batchId, status])
}

// ---------- Profiles & privacy (Phase 2) ----------

/**
 * Editable list: what a body profile measures (Height, Waist, Shoe size…).
 */
model MeasurementKind {
  id           String            @id @default(cuid())
  name         String            @unique
  unit         String            @default("")
  sortOrder    Int               @default(0)
  isArchived   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  measurements BodyMeasurement[]
}

/**
 * Editable list: style words a person picks for their style profile.
 */
model StyleWord {
  id         String   @id @default(cuid())
  name       String   @unique
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  people     Person[]
}

model BodyProfile {
  personId  String   @id
  fitNotes  String?
  updatedAt DateTime @updatedAt
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model BodyMeasurement {
  personId  String
  kindId    String
  value     String
  updatedAt DateTime        @updatedAt
  person    Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind      MeasurementKind @relation(fields: [kindId], references: [id], onDelete: Cascade)

  @@id([personId, kindId])
}

model BodySizeByBrand {
  id         String   @id @default(cuid())
  personId   String
  brandId    String
  categoryId String?
  size       String
  updatedAt  DateTime @updatedAt
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model BodyPhoto {
  id        String   @id @default(cuid())
  personId  String
  bucketKey String   @unique
  takenAt   DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

/**
 * Owner lets a viewer see their body profile.
 */
model BodyDataGrant {
  ownerId  String
  viewerId String
  owner    Person @relation("bodyGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer   Person @relation("bodyGrantViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([ownerId, viewerId])
}

/**
 * Owner lets a shopper shop on their behalf. Parents are implicit shoppers for minors.
 */
model ShopForGrant {
  ownerId   String
  shopperId String
  owner     Person @relation("shopGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shopper   Person @relation("shopGrantShopper", fields: [shopperId], references: [id], onDelete: Cascade)

  @@id([ownerId, shopperId])
}

/**
 * A parent admin approved body photos for a minor.
 */
model MinorBodyImageApproval {
  minorId      String   @id
  approvedById String
  approvedAt   DateTime @default(now())
  minor        Person   @relation("approvalMinor", fields: [minorId], references: [id], onDelete: Cascade)
  approvedBy   Person   @relation("approvalParent", fields: [approvedById], references: [id], onDelete: Cascade)
}
